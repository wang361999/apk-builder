# 数据库配置
# 生产环境（Vercel）必须配置 Turso，否则数据不会持久化！
# 运行 npm run setup 可自动创建 Turso 数据库并填入以下变量
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# 本地开发用 SQLite
DATABASE_URL="file:./dev.db"

# 管理员账号
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin666"

# Session 密钥
SESSION_SECRET="test_secret_key_for_local_testing_1234567890"

# GitHub 配置（也可在后台设置页配置）
GITHUB_TOKEN=""
GITHUB_REPO=""
GITHUB_BRANCH="main"

# 构建回调密钥
BUILD_WEBHOOK_SECRET="test_webhook_secret"
