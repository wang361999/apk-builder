# ============================================
# APK 生成器 - 环境变量
# 运行 `npm run setup` 可自动生成此文件
# ============================================

# ---------- 数据库（Vercel 生产环境必须用 Turso，否则数据不持久）----------
# 获取方式：
#   1. 注册 https://turso.tech
#   2. 运行 npm run setup 自动创建数据库并配置
#   3. 或手动在 Turso 后台创建数据库，获取以下两个值
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJF..."

# 本地开发用 SQLite（生产环境请配置上面的 Turso）
DATABASE_URL="file:./dev.db"

# ---------- 管理员账号（首次部署自动创建，之后可在后台修改）----------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin666"

# ---------- Session 加密密钥（自动生成，至少32位）----------
SESSION_SECRET="auto_generated_random_32_char_string"

# ---------- 构建回调密钥（自动生成，需同步配置到 GitHub Secrets）----------
BUILD_WEBHOOK_SECRET="auto_generated_random_24_char_string"

# ---------- GitHub 配置（用于触发 Actions 构建 APK，可在后台设置页配置）----------
GITHUB_TOKEN=""
GITHUB_REPO=""
GITHUB_BRANCH="main"
