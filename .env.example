# ============================================
# APK 生成器 - 环境变量
# 运行 `npm run setup` 可自动生成此文件
# ============================================

# 数据库（Vercel Postgres）
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 管理员账号（首次部署自动创建，之后可在后台修改）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin666"

# GitHub 配置（用于触发 Actions 构建 APK）
GITHUB_TOKEN="ghp_xxxxxxxxxxxx"
GITHUB_REPO="your-username/apk-builder"
GITHUB_BRANCH="main"

# Session 加密密钥（自动生成，至少32位）
SESSION_SECRET="auto_generated_random_32_char_string"

# 构建回调密钥（自动生成，需同步配置到 GitHub Secrets）
BUILD_WEBHOOK_SECRET="auto_generated_random_24_char_string"
