generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("user") // "admin" | "user"
  createdAt DateTime @default(now()) @map("created_at")

  buildRecords BuildRecord[]

  @@map("user")
}

model BuildRecord {
  id          Int      @id @default(autoincrement())
  url         String
  appName     String   @map("app_name")
  packageName String   @map("package_name")
  downloadUrl String?  @map("download_url")
  status      String   @default("building") // "building" | "success" | "failed"
  buildLog    String?  @map("build_log")
  versionName String?  @map("version_name")
  fileSize    Int?     @map("file_size") // bytes
  userId      Int?     @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("build_record")
}

model AppVersion {
  id          Int      @id @default(autoincrement())
  versionCode Int      @unique @map("version_code")
  versionName String   @map("version_name")
  updateLog   String   @map("update_log")
  downloadUrl String   @map("download_url")
  forceUpdate Boolean  @default(false) @map("force_update")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([versionCode])
  @@map("app_version")
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// 广告配置
model AdConfig {
  id             Int      @id @default(autoincrement())
  type           String   @unique // "splash" | "popup" | "banner"
  enabled        Boolean  @default(false)
  imageUrl       String   @default("") @map("image_url")
  linkUrl        String   @default("") @map("link_url")
  duration       Int      @default(3) // 显示时长（秒），仅 splash 用
  showTimesPerDay Int     @default(1) @map("show_times_per_day") // 每天显示次数，仅 popup 用
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ad_config")
}

// 功能开关
model FeatureFlag {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @default("true") // "true" | "false"
  description String   @default("")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flag")
}

// 样式配置
model StyleConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("style_config")
}

// 公告
model Announcement {
  id        Int      @id @default(autoincrement())
  enabled   Boolean  @default(false)
  text      String   @default("")
  linkUrl   String   @default("") @map("link_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcement")
}
